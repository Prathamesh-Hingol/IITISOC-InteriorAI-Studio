# ── Test data (required for AI-heavy scripts) ─────────────────────────────────
# A real project UUID owned by one of the test users above.
TEST_PROJECT_ID=

# A real generation/version UUID for editor.js tests.
TEST_VERSION_ID=

# A publicly accessible image URL used as AI generation input.
TEST_IMAGE_URL=https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80

# A Cloudinary mask URL for the editor/generate step.
TEST_MASK_URL=

# ── Test preset ───────────────────────────────────────────────────────────────
# smoke     → 1 VU / 30s   — sanity check
# load      → 10 VUs / 5m  — normal traffic (auto-switches to load_ai for heavy endpoints)
# stress    → 50 VUs / 8m  — breaking point
# soak      → 5 VUs / 20m  — memory leak detection
TEST_PRESET=smoke

# ── Token generation (for scripts/generate-tokens.js) ────────────────────────
# Your Clerk secret key
CLERK_SECRET_KEY=sk_test_2RAQVVQE3FhmLSAgPBtgXGDYPh9mkDw3r5WRFVsg9L

# Your Clerk Frontend API URL (find in Clerk Dashboard → API Keys)
CLERK_FRONTEND_API_URL=https://daring-aardvark-12.clerk.accounts.dev

# Number of virtual users / test accounts to create
NUM_USERS=5
