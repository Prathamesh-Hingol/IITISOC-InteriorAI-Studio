# .env.loadtest.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .env.loadtest (gitignored) and fill in your values.
# Source before running: source .env.loadtest
# Or docker compose will pick it up automatically via env_file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend target ────────────────────────────────────────────────────────────
# URL of the backend you want to load test.
# When running k6 inside Docker, use host.docker.internal to reach your local backend.
BASE_URL=http://host.docker.internal:5000

# ── Authentication ────────────────────────────────────────────────────────────
# Comma-separated pool of Clerk session JWTs — one per virtual user.
# Generate with: node scripts/generate-tokens.js
# Each k6 VU will round-robin through the pool: tokens[(__VU-1) % pool.length]
K6_TOKENS=eyJhbGci...,eyJhbGci...,eyJhbGci...

# ── Test data (required for AI-heavy scripts) ─────────────────────────────────
# A real project UUID owned by one of the test users above.
TEST_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# A real generation/version UUID for editor.js tests.
TEST_VERSION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# A publicly accessible image URL used as AI generation input.
TEST_IMAGE_URL=https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80

# A Cloudinary mask URL for the editor/generate step.
TEST_MASK_URL=https://res.cloudinary.com/your-cloud/image/upload/your-mask.png

# ── Test preset ───────────────────────────────────────────────────────────────
# smoke     → 1 VU / 30s   — sanity check
# load      → 10 VUs / 5m  — normal traffic (auto-switches to load_ai for heavy endpoints)
# stress    → 50 VUs / 8m  — breaking point
# soak      → 5 VUs / 20m  — memory leak detection
TEST_PRESET=smoke

# ── Token generation (for scripts/generate-tokens.js) ────────────────────────
# Your Clerk secret key
CLERK_SECRET_KEY=sk_test_replace_me

# Your Clerk Frontend API URL (find in Clerk Dashboard → API Keys)
# Format: https://your-app.clerk.accounts.dev  (dev)
#         https://clerk.yourdomain.com          (prod)
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev

# Number of virtual users / test accounts to create
NUM_USERS=5
