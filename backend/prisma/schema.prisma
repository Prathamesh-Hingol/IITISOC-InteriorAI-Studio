datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id // Clerk User ID
  email     String    @unique
  firstName String?
  lastName  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  generations Generation[]
}

model Generation {
  id                 String       @id @default(uuid())
  title              String
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId           String?
  parent             Generation?  @relation("GenerationBranch", fields: [parentId], references: [id], onDelete: Cascade)
  children           Generation[] @relation("GenerationBranch")
  imageUrl           String
  prompt             String?
  preset             String?
  creativityStrength Int?
  generationMode     String? // "restyle" | "furnish-empty"
  status             String // "pending" | "completed" | "failed"
  job                GenerationJob?
  depth              GenerationDepth?
  x                  Float?
  y                  Float?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([parentId])
}

enum GenerationJobType {
  ROOT
  BRANCH
  EDITOR
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model GenerationJob {
  id             String            @id @default(uuid())
  generationId   String            @unique
  generation     Generation        @relation(fields: [generationId], references: [id], onDelete: Cascade)
  type           GenerationJobType
  status         JobStatus         @default(QUEUED)
  payload        Json
  attempts       Int               @default(0)
  queuedAt       DateTime          @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureMessage String?

  @@index([status, queuedAt])
}

model GenerationDepth {
  generationId String     @id
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  previewUrl   String?
  raw16Url     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
